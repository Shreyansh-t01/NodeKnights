{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nodeknights-production.up.railway.app/api/:path*"
    },
    {
      "source": "/intake",
      "destination": "/index.html"
    },
    {
      "source": "/contracts",
      "destination": "/index.html"
    },
    {
      "source": "/insights",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/documents",
      "destination": "/index.html"
    }
  ]
}
