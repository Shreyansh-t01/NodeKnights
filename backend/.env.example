# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api
CORS_ORIGIN=https://node-knights-kwuw.vercel.app
MAX_UPLOAD_SIZE_MB=20
TEMP_STORAGE_DIR=./tmp
REMOTE_SERVICE_TIMEOUT_MS=15000
ML_SERVICE_URL=https://nodeknights-production-2b89.up.railway.app
ML_SERVICE_TIMEOUT_MS=60000
REQUIRE_PYTHON_ML_SERVICE=true
STRICT_REMOTE_SERVICES=false
FIREBASE_ENABLED=false

# Authentication
AUTH_USERNAME=
AUTH_PASSWORD=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Artifact storage
ARTIFACT_STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# Google connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nodeknights-production.up.railway.app/api/connectors/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_USER=me
APP_BASE_URL=https://node-knights-kwuw.vercel.app
GOOGLE_DRIVE_FOLDER_IDS=
GOOGLE_DRIVE_WEBHOOK_URL=https://nodeknights-production.up.railway.app/api/connectors/drive/notifications
GOOGLE_DRIVE_WATCH_ENABLED=false
GOOGLE_DRIVE_WATCH_CHANNEL_TOKEN=
GOOGLE_DRIVE_WATCH_EXPIRATION_MS=604800000
GOOGLE_DRIVE_WATCH_RENEWAL_LEAD_MS=21600000
GOOGLE_DRIVE_WATCH_RENEWAL_CHECK_MS=3600000
GMAIL_DEFAULT_QUERY=has:attachment filename:pdf newer_than:30d
GMAIL_POLL_ENABLED=false
GMAIL_POLL_INTERVAL_MS=300000
GMAIL_POLL_MAX_RESULTS=10
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_RECIPIENTS=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=contracts
PINECONE_CONTRACT_NAMESPACE=contracts
PINECONE_PRECEDENT_NAMESPACE=precedents
PINECONE_KNOWLEDGE_NAMESPACE=knowledge
PINECONE_API_VERSION=2026-04
PINECONE_TEXT_FIELD=chunk_text
PINECONE_INTEGRATED_MODEL=
PINECONE_TEXT_UPSERT_BATCH_SIZE=96
EMBEDDING_PROVIDER=pinecone
EMBEDDING_DIMENSION=128

# Firestore collections for deployed precedent/rule storage
PRECEDENT_COLLECTION=precedents
KNOWLEDGE_COLLECTION=knowledge_documents

# GenAI
GENAI_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_MODEL_CANDIDATES=gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GENAI_TIMEOUT_MS=15000
GENAI_MAX_RETRIES=1
GENAI_MAX_CONCURRENT_REQUESTS=1
GENAI_RETRY_BASE_MS=1500
GENAI_RETRY_MAX_MS=12000
GENAI_TEMPERATURE=0.1
GENAI_MAX_OUTPUT_TOKENS=900
GENAI_THINKING_BUDGET=0
RULEBOOK_PATH=./data/rulebook.json
